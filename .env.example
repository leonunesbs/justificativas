# Copie para `.env.local` e preencha:
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Clerk — contas e assinatura (https://dashboard.clerk.com)
# ---------------------------------------------------------------------------
# Painel do app → "API keys". Necessário para o app subir (ClerkProvider).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Slug do plano que libera a busca no FastMedic.
# Crie o plano em Clerk Dashboard → Billing → Plans com este slug.
# Opcional — o padrão é "pro".
NEXT_PUBLIC_CLERK_PLAN_SLUG=pro

# Observações:
# - As credenciais do FastMedic (CPF/senha) NÃO ficam aqui: são digitadas na
#   própria interface e guardadas só no navegador do usuário.
# - Habilite o Billing no Clerk Dashboard e crie ao menos um plano com o slug
#   acima para que assinantes consigam usar a busca.
